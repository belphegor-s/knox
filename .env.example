# Knox is local-first: none of these are required to run the app. They only
# matter once you deploy optional server-side features (see docs/cloud-runtime.md).

# Port the container listens on / is published on.
KNOX_PORT=8080

# --- Optional, future cloud features -----------------------------------------
# Uncomment and set these only if you enable the corresponding service in
# infra/docker-compose.yml. Nothing in the current build reads them yet.

# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://knox:${POSTGRES_PASSWORD}@postgres:5432/knox
# REDIS_URL=redis://redis:6379

# AI provider keys are configured per-user, in-browser, via Settings → AI -
# never set them here. See docs/security.md "AI provider security".
