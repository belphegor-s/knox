# Knox is local-first: none of these are required to run the app itself. They
# only matter for (a) deploying it, or (b) enabling optional server-side
# features (see docs/cloud-runtime.md).

# Port the container listens on / is published on.
KNOX_PORT=8080

# --- Deployment automation (Coolify) ------------------------------------------
# Used by scripts that create/update/deploy the Coolify application via its
# API - not read by the app itself.
#
# COOLIFY_API_TOKEN scopes (Coolify → Keys & Tokens → create a new token):
#   - read     (list projects/servers/destinations/applications)
#   - write    (create projects and applications, update app config)
#   - deploy   (POST /deploy to trigger a build)
# "read:sensitive" is NOT needed - nothing here reads env vars/secrets back off
# an existing application.
COOLIFY_API_URL=https://your-coolify-instance.example.com
COOLIFY_API_TOKEN=

# --- Cloudflare (only if your Coolify/API is behind Cloudflare Access) -------
# Kept in separate gitignored files, not here, since they're account-level
# secrets rather than per-app config:
#
#   .cf_token              - a Cloudflare API token (My Profile → API Tokens →
#                             Create Token → Custom Token) with:
#                               Account | Access: Apps and Policies | Edit
#                               Zone    | DNS                       | Edit  (only the zone(s) you'll add records to)
#                             Used to create/manage Access Service Tokens and
#                             policies, and to create the DNS record pointing
#                             your subdomain at the target server.
#
#   .cf_service_token       - CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET,
#                             a Cloudflare Access Service Token (created via
#                             the API using .cf_token above) added to the
#                             Access policy protecting your Coolify API path.
#                             Sent as the CF-Access-Client-Id / CF-Access-
#                             Client-Secret headers on every Coolify API call.

# --- Cloud execution on AWS (planned - not wired up yet) ---------------------
# For the on-demand Fargate execution backend. An IAM user/role scoped to:
#   - ecs:RunTask, ecs:StopTask, ecs:DescribeTasks, ecs:RegisterTaskDefinition
#   - ecr:GetAuthorizationToken, ecr:BatchCheckLayerAvailability,
#     ecr:PutImage, ecr:InitiateLayerUpload, ecr:UploadLayerPart,
#     ecr:CompleteLayerUpload  (only needed to push the runner image to ECR)
#   - iam:PassRole  (to pass the ECS task execution role to RunTask)
# Not least-privilege-audited yet - narrow further once the actual task
# definition and cluster are in place. Not yet consumed by any code here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# --- Optional, future cloud features -----------------------------------------
# Uncomment and set these only if you enable the corresponding service in
# infra/docker-compose.yml. Nothing in the current build reads them yet.

# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://knox:${POSTGRES_PASSWORD}@postgres:5432/knox
# REDIS_URL=redis://redis:6379

# AI provider keys are configured per-user, in-browser, via Settings → AI -
# never set them here. See docs/security.md "AI provider security".
