{
  "name": "knox",
  "private": true,
  "version": "0.1.0",
  "description": "Knox - a local-first, browser-native development environment",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @knox/web dev",
    "dev:api": "pnpm --filter @knox/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @knox/web test:e2e",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
